def _to_ny_tz(df: pd.DataFrame) -> pd.DataFrame:
    df = df.copy()
    if df.index.tz is None:
        df.index = df.index.tz_localize(NY_TZ)
    else:
        df.index = df.index.tz_convert(NY_TZ)
    return df


def _count_consecutive(series: pd.Series, level: float, direction: str = "above") -> int:
    count = 0
    for val in reversed(series.dropna().tolist()):
        ok = (val > level) if direction == "above" else (val < level)
        if ok:
            count += 1
        else:
            break
    return count


def fetch_index_data(symbol: str) -> dict:
    now_ny = datetime.now(NY_TZ)
    today_ny = now_ny.date()
    ticker = yf.Ticker(symbol)

    # auto_adjust=False שומר על מחירי המסחר הגולמיים התואמים לקווים ב-TradingView
    daily = ticker.history(period="400d", interval="1d", auto_adjust=False)
    if daily.empty or len(daily) < 200:
        raise ValueError(f"לא התקבלו מספיק נתונים היסטוריים עבור {symbol}")

    daily = _to_ny_tz(daily)
    completed_daily = daily[daily.index.date < today_ny]

    intraday = ticker.history(period="1d", interval="1m", prepost=False)
    has_live_today = False

    if not intraday.empty:
        intraday = _to_ny_tz(intraday)
        intraday_today = intraday[intraday.index.date == today_ny]
        if not intraday_today.empty:
            has_live_today = True
            live_price = float(intraday_today["Close"].iloc[-1])
            today_low = float(intraday_today["Low"].min())
            today_vol = float(intraday_today["Volume"].sum())
            last_ts = intraday_today.index[-1]

    if has_live_today:
        closes = pd.concat([completed_daily["Close"], pd.Series([live_price], index=[last_ts])])
        lows = pd.concat([completed_daily["Low"], pd.Series([today_low], index=[last_ts])])
        eff_date = today_ny
        source_note = f"נתון חי ({last_ts.strftime('%H:%M')} NY)"
    else:
        closes = daily["Close"]
        lows = daily["Low"]
        live_price = float(closes.iloc[-1])
        today_low = float(lows.iloc[-1])
        today_vol = float(daily["Volume"].iloc[-1])
        eff_date = daily.index[-1].date()
        source_note = f"סגירה אחרונה ({eff_date.isoformat()})"

    return {
        "closes": closes,
        "lows": lows,
        "price": live_price,
        "today_vol": today_vol,
        "sma150": float(closes.rolling(150).mean().iloc[-1]),
        "sma200": float(closes.rolling(200).mean().iloc[-1]),
        "eff_date": eff_date,
        "is_weekly": eff_date.weekday() == 4,
        "source_note": source_note,
    }


def evaluate_plan(symbol: str, cfg: dict) -> dict:
    d = fetch_index_data(symbol)
    r = cfg["rules"]
    stage = cfg["stage"]
    price = d["price"]
    sma200 = d["sma200"]
    sma200_buf = sma200 * 0.98
    closes = d["closes"]
    eff_date = d["eff_date"]
    is_weekly = d["is_weekly"]

    cooldown_until = date.fromisoformat(cfg["cooldown_until"])
    time_stop_date = date.fromisoformat(cfg["time_stop_date"])

    consec_above_t2 = _count_consecutive(closes, r["t2_level"], "above")
    consec_below_s1 = _count_consecutive(closes, r["stop_stage1_close"], "below")
    consec_above_alt = _count_consecutive(closes, r["t1_alt_base"], "above") if r["t1_alt_base"] else 0

    recent_min_low = float(d["lows"].tail(3).min())
    # בודק שהייתה נסיגה מתחת לתקרת אזור האיסוף מבלי לשבור את רצפת השפל של שישי
    touched_pullback = r["stop_stage1_close"] < recent_min_low <= r["t1_pullback_high"]
    vol_ratio_pct = (d["today_vol"] / r["panic_ref_vol"]) * 100
    vol_calmer = d["today_vol"] < r["panic_ref_vol"]

    signal = "WAIT"
    headline = "המתנה — אין טריגר פעיל"
    details = "אף תנאי לא נדלק בשלב הנוכחי. לסגור מסך ולבדוק שוב מחר ב-22:30."

    if stage == 0:
        if eff_date < cooldown_until:
            headline = f"תקופת צינון עד {cooldown_until.isoformat()}"
            details = "לא רודפים אחרי הגאפ. ממתינים לעיכול השוק לפני פתיחת מנה 1."
        else:
            pullback_ok = touched_pullback and price > r["t1_confirm_close"] and vol_calmer
            alt_ok = (
                r["t1_alt_breakout"] is not None
                and consec_above_alt >= 3
                and price > r["t1_alt_breakout"]
            )
            if pullback_ok:
                signal = "BUY"
                headline = "טריגר מנה 1 (30%) — נר בלימה מאושר"
                details = (
                    f"נבדק אזור הנסיגה (נמוך {recent_min_low:.2f}$) וסגירה מעל {r['t1_confirm_close']}$ "
                    f"במחזור רגוע ({vol_ratio_pct:.0f}% ממחזור הפאניקה). "
                    f"סטופ חירום קשיח: {r['stop_stage1_hard']}$."
                )
            elif alt_ok:
                signal = "BUY"
                headline = "טריגר מנה 1 (30%) — פריצת בסיס"
                details = f"{consec_above_alt} סגירות מעל {r['t1_alt_base']}$ ופריצה מעל {r['t1_alt_breakout']}$."
            elif touched_pullback:
                signal = "WATCH"
                headline = "באזור איסוף — ממתין לאישור סגירה"
                details = f"המחיר נגע באזור הנסיגה ({recent_min_low:.2f}$), נדרשת סגירה מעל {r['t1_confirm_close']}$."

    elif stage == 1:
        if price <= r["stop_stage1_hard"]:
            signal = "STOP"
            headline = f"סטופ חירום קשיח ({r['stop_stage1_hard']}$) — יציאה מיידית!"
            details = "שבירה חדה מתחת לרצפת החירום. סגירה מלאה."
        elif consec_below_s1 >= 2:
            signal = "STOP"
            headline = f"סטופ מבני (2 סגירות מתחת ל-{r['stop_stage1_close']}$)"
            details = "תזת התחתית בוטלה. סגירת מנה 1 ללא דיחוי."
        elif consec_below_s1 == 1:
            signal = "WATCH"
            headline = f"אזהרת סטופ — יום 1 מתוך 2 מתחת ל-{r['stop_stage1_close']}$"
            details = "סגירה נוספת מחר מתחת לרמה מחייבת יציאה מלאה."
        elif eff_date >= time_stop_date and price < sma200:
            signal = "STOP"
            headline = "סטופ זמן — 60 ימי מסחר מתחת ל-SMA 200"
            details = "המדד נכשל בהתבססות מעל המגמה הארוכה. לסגור ולחזור למזומן נושא ריבית."
        elif consec_above_t2 >= 2 or (is_weekly and price > r["t2_level"]):
            signal = "BUY"
            headline = f"טריגר מנה 2 (40%) — אישור מעל {r['t2_level']}$!"
            details = f"התבססות מאושרת ({consec_above_t2} סגירות). לקדם סטופ מבני שבועי ל-{r['stop_stage2_weekly']}$."
        elif consec_above_t2 == 1:
            signal = "WATCH"
            headline = f"התראת מנה 2 — יום 1 מתוך 2 מעל {r['t2_level']}$"
            details = "סגירה נוספת מחר מעל הרמה תפעיל את מנה 2 (40%)."

    elif stage == 2:
        if is_weekly and price < r["stop_stage2_weekly"]:
            signal = "STOP"
            headline = f"סטופ שבועי שלב 2 (מתחת ל-{r['stop_stage2_weekly']}$)"
            details = "שבירה בסגירת יום שישי. סגירת כלל הפוזיציה."
        elif price < r["stop_stage2_weekly"]:
            signal = "WATCH"
            headline = f"אזהרה — מתחת לסטופ השבועי ({r['stop_stage2_weekly']}$)"
            details = "לא יום שישי — לעקוב לקראת הסגירה השבועית."
        elif is_weekly and price > r["t3_weekly_level"]:
            signal = "BUY"
            headline = f"טריגר מנה 3 (30%) — פריצה שבועית מעל {r['t3_weekly_level']}$!"
            details = f"להשלים ל-100% ולעבור לסטופ נגרר 2% מתחת ל-SMA 200 ({sma200_buf:.2f}$)."
        elif price > r["t3_weekly_level"]:
            signal = "WATCH"
            headline = f"מעל יעד מנה 3 ({r['t3_weekly_level']}$) — ממתין ליום שישי"
            details = "הטריגר למנה 3 נבדק בסגירה השבועית."

    elif stage == 3:
        if price < sma200_buf:
            signal = "STOP"
            headline = f"סטופ נגרר — שבירת SMA 200 מינוס 2% ({sma200_buf:.2f}$)"
            details = "סגירה מתחת לרצועת הביטחון. יציאה משמעתית."
        elif price >= r["profit_target_low"]:
            signal = "TAKE_PROFIT"
            headline = f"יעד מימוש שליש ({r['profit_target_low']}$–{r['profit_target_high']}$)"
            details = "לממש 30%–35% לקיבוע רווח ולהצמיד ליתרה סטופ מתחת ל-SMA 50."

    return {
        "symbol": symbol,
        "stage": stage,
        "price": price,
        "sma150": d["sma150"],
        "sma200": sma200,
        "sma200_buf": sma200_buf,
        "dist_sma200": ((price / sma200) - 1) * 100,
        "consec_above_t2": consec_above_t2,
        "consec_below_s1": consec_below_s1,
        "vol_ratio_pct": vol_ratio_pct,
        "is_weekly": is_weekly,
        "source_note": d["source_note"],
        "signal": signal,
        "headline": headline,
        "details": details,
        "t2_level": r["t2_level"],
        "stop_s1": r["stop_stage1_close"],
        "tv_url": f"https://www.tradingview.com/chart/?symbol={symbol}",
    }


